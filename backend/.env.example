# Backend configuration. Copy to backend/.env for local development.
# backend/.env is git-ignored. Never commit real values.
# With no .env at all, the backend starts in the local profile against the emulators.

NODE_ENV=development
PORT=8080

# Execution profile (docs/03_TECH_ARCHITECTURE.md §2.2):
#   local → Firebase emulators, mock commerce, simulator channel, mock agent,
#           local file storage, local event sink. No Google Cloud needed.
#   gcp   → real services; refuses every mock/local adapter at startup.
BUILDWISE_PROFILE=local

# Local profile defaults (shown explicitly). "demo-" project IDs never touch real cloud resources.
GOOGLE_CLOUD_PROJECT=demo-buildwise
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Where LocalFileStorageProvider and LocalEventSink write (git-ignored).
LOCAL_DATA_DIR=.data

# Adapter selectors. Leave empty to use the profile default. Overrides exist only
# for isolated integration spikes (docs/10_EXECUTION_PLAN.md §5).
COMMERCE_PROVIDER=
MESSAGING_CHANNELS=
AGENT_RUNTIME=
FILE_STORAGE=
EVENT_SINK=

# Only needed if the frontend calls the API directly instead of via
# the same-origin /api proxy/rewrite. Comma-separated exact origins.
CORS_ALLOWED_ORIGINS=

LOG_LEVEL=info
