# Backend (Cloud Run) configuration. Copy to backend/.env for local development.
# backend/.env is git-ignored. Never commit real values.

NODE_ENV=development
PORT=8080

# Local development against the Firebase emulators (npm run emulators).
# "demo-" project IDs never touch real cloud resources.
GOOGLE_CLOUD_PROJECT=demo-buildwise
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# To use a real Firebase project locally instead: set GOOGLE_CLOUD_PROJECT to it,
# remove the two *_EMULATOR_HOST lines, and run
#   gcloud auth application-default login
# (Application Default Credentials; no service-account key files.)

# Only needed if the frontend calls Cloud Run directly instead of via
# the same-origin /api proxy/rewrite. Comma-separated exact origins.
CORS_ALLOWED_ORIGINS=

LOG_LEVEL=info
