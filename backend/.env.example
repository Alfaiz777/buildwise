# Backend configuration. Copy to backend/.env for local development.
# backend/.env is git-ignored. Never commit real values.
# With no .env at all, the backend starts in the local profile against the emulators.

NODE_ENV=development
PORT=8080

# Execution profile (docs/03_TECH_ARCHITECTURE.md §2.2):
#   local → Firebase emulators, mock commerce, simulator channel, mock agent,
#           local file storage, local event sink. No Google Cloud needed.
#   gcp   → real services; refuses every mock/local adapter at startup.
QWIKSPOT_PROFILE=local

# Local profile defaults (shown explicitly). "demo-" project IDs never touch real cloud resources.
GOOGLE_CLOUD_PROJECT=demo-qwikspot
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Where LocalFileStorageProvider and LocalEventSink write (git-ignored).
LOCAL_DATA_DIR=.data

# Adapter selectors. Leave empty to use the profile default. Overrides exist only
# for isolated integration spikes (docs/10_EXECUTION_PLAN.md §5).
COMMERCE_PROVIDER=
MESSAGING_CHANNELS=
AGENT_RUNTIME=
FILE_STORAGE=
EVENT_SINK=

# Only needed if the frontend calls the API directly instead of via
# the same-origin /api proxy/rewrite. Comma-separated exact origins.
CORS_ALLOWED_ORIGINS=

LOG_LEVEL=info

# M7 — judge experience (docs/00 §11.8 Change 14, G3–G5). DEMO_MODE never weakens authorization.
# On locally and for the judged deployment only. With it on, GET /api/demo/config returns the
# demo logins (locally: the seeded users; deployed: DEMO_LOGINS from Secret Manager) and the
# allowlisted brand's Brand Admin gets "Reset demo".
DEMO_MODE=true
DEMO_BRAND_IDS=brd_demo
DEMO_HOLD_MINUTES=20
# DEMO_LOGINS=[{"email":"...","password":"...","role":"BRAND_ADMIN","title":"...","hint":"..."}]   # deployed only (secret)
# Change 16 — shopper demo (/shop, /chat). Signs shopper chat sessions; required in gcp when
# DEMO_MODE=true (>= 32 chars, Secret Manager). Locally optional: a random per-process secret.
# SHOPPER_SESSION_SECRET=
# Public web origin used to make image URLs absolute (local default http://localhost:5173).
# PUBLIC_WEB_ORIGIN=

# L2-Shopify — a real Shopify store on the local profile (README "Connect a real Shopify store").
# Leave COMMERCE_PROVIDER unset (= mock) unless you connect a store. Placeholders only: the
# client secret and the encryption key are secrets — keep them in your own backend/.env.
# COMMERCE_PROVIDER=shopify
# SHOPIFY_API_KEY=<Dev Dashboard → your app → Settings → Client ID>
# SHOPIFY_API_SECRET=<Dev Dashboard → your app → Settings → Client secret>
# SHOPIFY_SCOPES=read_products,read_inventory,read_customers,read_orders
# SHOPIFY_API_VERSION=2026-10
# The https dev tunnel that forwards to this backend (localhost:8080), no trailing slash:
# PUBLIC_BACKEND_URL=https://<your-tunnel>.devtunnels.ms
# FRONTEND_URL=http://localhost:5173
# 32 random bytes, base64 — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# TOKEN_ENCRYPTION_KEY=

# seed:live / demo:check against a real project only (never the local password):
# DEMO_PASSWORD=

# Reported by GET /api/health (set by infrastructure/scripts/deploy-backend.sh when deployed).
BUILD_VERSION=dev
BUILD_COMMIT=
