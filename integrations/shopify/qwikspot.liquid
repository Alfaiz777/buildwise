{%- comment -%}
  Qwikspot for Shopify (L4). Paste this whole file into Online Store → Themes → Edit code →
  Snippets → "qwikspot", then add {% render 'qwikspot' %} just before </body> in layout/theme.liquid.
  Generated from integrations/shopify/qwikspot-shopify.js by `npm run shopify:snippet` — edit
  that file and rebuild rather than changing the script below by hand.

  The two settings: where Qwikspot runs, and this store's brand id in Qwikspot.
{%- endcomment -%}
{%- liquid
  assign qs_api = 'https://app.qwikspot.urbanlyfe.in'
  assign qs_brand = 'brd_demo'
-%}
<script id="qwikspot-config" type="application/json">
  {
    "apiBaseUrl": {{ qs_api | json }},
    "brandId": {{ qs_brand | json }},
    "template": {{ template.name | json }},
    "product": {%- if template.name == 'product' and product -%}
      {
        "title": {{ product.title | json }},
        "variant": {{ product.selected_or_first_available_variant.id | json }}
      }
    {%- else -%}null{%- endif -%},
    "searchTerms": {%- if search.performed -%}{{ search.terms | json }}{%- else -%}null{%- endif -%},
    "cartVariant": {%- if cart.item_count > 0 -%}{{ cart.items.first.variant_id | json }}{%- else -%}null{%- endif %}
  }
</script>
<script>
/*
 * Qwikspot for Shopify themes (L4): tracks the shopper's steps for intent, and adds
 * "Need it today? Ask on WhatsApp" under Add to cart plus a WhatsApp bubble on every page.
 *
 * Source of the script tag inside integrations/shopify/qwikspot.liquid — edit this file, then run
 * `npm run shopify:snippet` (scripts/build-shopify-snippet.mjs) to rebuild the Liquid snippet.
 *
 * Reads its settings from the JSON script tag with id "qwikspot-config" (written by the
 * Liquid snippet from Shopify's own objects). Sends only variant GIDs, the search words and
 * event types — never names, emails, phone numbers or cart tokens. Every failure is silent.
 */
(function () {
  'use strict';
  if (window.__qwikspotShopify) return; // the theme rendered the snippet twice
  window.__qwikspotShopify = true;

  var VISIT_KEY = 'qs_visit_sent';
  var GID = 'gid://shopify/ProductVariant/';
  var config = readConfig();
  if (!config || !config.apiBaseUrl || !config.brandId) return;

  var product = config.product || null;
  var currentVariant = product && product.variant ? String(product.variant) : null;
  var lastSent = {};
  var entryPoints = [];
  var warned = false;

  function readConfig() {
    try {
      var el = document.getElementById('qwikspot-config');
      return el ? JSON.parse(el.textContent || '{}') : null;
    } catch (e) {
      return null;
    }
  }

  function noop() {}

  /** "12345" or "gid://shopify/ProductVariant/12345" → the GID the backend stores; null otherwise. */
  function gid(id) {
    var digits = id === null || id === undefined ? '' : String(id).replace(/^gid:\/\/shopify\/ProductVariant\//, '');
    return /^\d+$/.test(digits) ? GID + digits : null;
  }

  function numeric(id) {
    var g = gid(id);
    return g ? g.slice(GID.length) : null;
  }

  var intent = null;
  /** QwikspotIntent as it was when this snippet started (later replacements are ignored). */
  function api() {
    return intent || window.QwikspotIntent;
  }

  /** Sends one event; the same event for the same variant at most once per 1.5 s (submit + fetch). */
  function send(type, data) {
    try {
      var key = type + ':' + ((data && (data.variantId || data.searchTerm)) || '');
      var now = Date.now();
      if (lastSent[key] && now - lastSent[key] < 1500) return;
      lastSent[key] = now;
      var result = api().track(type, data || {});
      if (result && result.then) {
        result.then(function (res) {
          // Hidden only when Qwikspot says so — never because a request failed.
          if (res && res.whatsapp_available === false) hideEntryPoints();
        }, warnOnce);
      }
    } catch (e) {
      warnOnce(e);
    }
  }

  /** Shoppers see nothing; one line in DevTools per page says why events are not arriving. */
  function warnOnce(err) {
    if (warned) return;
    warned = true;
    try {
      var why =
        err && typeof err.status === 'number'
          ? 'HTTP ' + err.status + (err.error && err.error.code ? ' ' + err.error.code : '')
          : 'blocked (CORS/network)';
      console.warn('[Qwikspot] storefront events are not reaching Qwikspot: ' + why);
    } catch (e) {
      /* ignore */
    }
  }

  function isMobile() {
    return /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent || '');
  }

  // ---------- variants ----------

  /** The variant the shopper has chosen: the product form's id input, else ?variant=, else the first. */
  function selectedVariant() {
    var input = document.querySelector('form[action*="/cart/add"] [name="id"]');
    if (input && input.value && gid(input.value)) return String(input.value);
    var fromUrl = new URLSearchParams(window.location.search).get('variant');
    if (fromUrl && gid(fromUrl)) return fromUrl;
    return currentVariant;
  }

  function checkVariant() {
    var next = selectedVariant();
    if (next && next !== currentVariant) {
      currentVariant = next;
      send('VARIANT_SELECTED', { variantId: gid(next) });
      updateLinks();
    }
  }

  function watchVariants() {
    // Savor / Dawn-style themes change the hidden id input and replace ?variant= in the URL.
    document.addEventListener('change', function () {
      setTimeout(checkVariant, 0);
    });
    ['pushState', 'replaceState'].forEach(function (name) {
      var original = window.history[name];
      if (typeof original !== 'function') return;
      window.history[name] = function () {
        var result = original.apply(this, arguments);
        setTimeout(checkVariant, 0);
        return result;
      };
    });
    window.addEventListener('popstate', checkVariant);
  }

  // ---------- cart and checkout ----------

  function variantFromBody(body) {
    try {
      if (!body) return null;
      if (typeof FormData !== 'undefined' && body instanceof FormData) return body.get('id');
      if (typeof URLSearchParams !== 'undefined' && body instanceof URLSearchParams) return body.get('id');
      if (typeof body === 'string') {
        if (body.charAt(0) === '{') {
          var json = JSON.parse(body);
          return json.id || (json.items && json.items[0] && json.items[0].id) || null;
        }
        return new URLSearchParams(body).get('id');
      }
    } catch (e) {
      /* unknown body */
    }
    return null;
  }

  function watchCart() {
    // A plain product form submit (themes without AJAX cart).
    document.addEventListener(
      'submit',
      function (event) {
        var form = event.target;
        if (!form || !form.getAttribute || (form.getAttribute('action') || '').indexOf('/cart/add') === -1) return;
        var input = form.querySelector('[name="id"]');
        var id = gid(input && input.value);
        if (id) send('ADD_TO_CART', { variantId: id });
      },
      true,
    );
    // AJAX carts call /cart/add with fetch: wrapped, never changed.
    if (typeof window.fetch === 'function') {
      var originalFetch = window.fetch;
      window.fetch = function (resource, init) {
        try {
          var url = typeof resource === 'string' ? resource : (resource && resource.url) || '';
          if (url.indexOf('/cart/add') !== -1) {
            var id = gid(variantFromBody(init && init.body));
            if (id) send('ADD_TO_CART', { variantId: id });
          }
        } catch (e) {
          /* ignore */
        }
        return originalFetch.apply(this, arguments);
      };
    }
    // The cart page's or the cart drawer's checkout button.
    document.addEventListener(
      'click',
      function (event) {
        var target =
          event.target && event.target.closest ? event.target.closest('[name="checkout"], a[href*="/checkout"]') : null;
        if (!target) return;
        var fromLiquid = gid(config.cartVariant);
        if (fromLiquid) return send('CHECKOUT_STARTED', { variantId: fromLiquid });
        if (typeof window.fetch !== 'function') return;
        window
          .fetch('/cart.js', { credentials: 'same-origin' })
          .then(function (res) {
            return res.json();
          })
          .then(function (cart) {
            var id = gid(cart && cart.items && cart.items[0] && cart.items[0].variant_id);
            if (id) send('CHECKOUT_STARTED', { variantId: id });
          })
          .catch(noop);
      },
      true,
    );
  }

  // ---------- QR code (the desktop "scan to continue on WhatsApp") ----------
  //
  // A small QR Code encoder (byte mode, error correction L/M/Q/H, versions 1–40), after the QR
  // Code spec and Project Nayuki's reference design; the same encoder as the Brand Console's
  // (frontend/src/lib/qr.ts), checked module for module against the reference Python `qrcode`
  // package. Drawn here, in the shopper's browser: the link is sent to no QR service.
  function qrMatrix(text, eclName, forcedMask) {
    var ECL = { L: [0, 1], M: [1, 0], Q: [2, 3], H: [3, 2] }; // [table row, format bits]
    var ecl = ECL[eclName || 'M'];
    var ECC_PER_BLOCK = [
      [
        -1, 7, 10, 15, 20, 26, 18, 20, 24, 30, 18, 20, 24, 26, 30, 22, 24, 28, 30, 28, 28, 28, 28, 30, 30, 26, 28, 30,
        30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30,
      ],
      [
        -1, 10, 16, 26, 18, 24, 16, 18, 22, 22, 26, 30, 22, 22, 24, 24, 28, 28, 26, 26, 26, 26, 28, 28, 28, 28, 28, 28,
        28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28,
      ],
      [
        -1, 13, 22, 18, 26, 18, 24, 18, 22, 20, 24, 28, 26, 24, 20, 30, 24, 28, 28, 26, 30, 28, 30, 30, 30, 30, 28, 30,
        30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30,
      ],
      [
        -1, 17, 28, 22, 16, 22, 28, 26, 26, 24, 28, 24, 28, 22, 24, 24, 30, 28, 28, 26, 28, 30, 24, 30, 30, 30, 30, 30,
        30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30,
      ],
    ];
    var BLOCKS = [
      [
        -1, 1, 1, 1, 1, 1, 2, 2, 2, 2, 4, 4, 4, 4, 4, 6, 6, 6, 6, 7, 8, 8, 9, 9, 10, 12, 12, 12, 13, 14, 15, 16, 17, 18,
        19, 19, 20, 21, 22, 24, 25,
      ],
      [
        -1, 1, 1, 1, 2, 2, 4, 4, 4, 5, 5, 5, 8, 9, 9, 10, 10, 11, 13, 14, 16, 17, 17, 18, 20, 21, 23, 25, 26, 28, 29,
        31, 33, 35, 37, 38, 40, 43, 45, 47, 49,
      ],
      [
        -1, 1, 1, 2, 2, 4, 4, 6, 6, 8, 8, 8, 10, 12, 16, 12, 17, 16, 18, 21, 20, 23, 23, 25, 27, 29, 34, 34, 35, 38, 40,
        43, 45, 48, 51, 53, 56, 59, 62, 65, 68,
      ],
      [
        -1, 1, 1, 2, 4, 4, 4, 5, 6, 8, 8, 11, 11, 16, 16, 18, 16, 19, 21, 25, 25, 25, 34, 30, 32, 35, 37, 40, 42, 45,
        48, 51, 54, 57, 60, 63, 66, 70, 74, 77, 81,
      ],
    ];

    // UTF-8 bytes of the text.
    var bytes = [];
    var utf8 = unescape(encodeURIComponent(text));
    for (var c = 0; c < utf8.length; c++) bytes.push(utf8.charCodeAt(c));

    function rawModules(ver) {
      var r = (16 * ver + 128) * ver + 64;
      if (ver >= 2) {
        var n = Math.floor(ver / 7) + 2;
        r -= (25 * n - 10) * n - 55;
        if (ver >= 7) r -= 36;
      }
      return r;
    }
    function dataCodewords(ver) {
      return Math.floor(rawModules(ver) / 8) - ECC_PER_BLOCK[ecl[0]][ver] * BLOCKS[ecl[0]][ver];
    }

    // The smallest version that holds the data (byte mode: 4 mode bits + 8/16 count bits).
    var ver = 1;
    for (; ; ver++) {
      if (ver > 40) throw new Error('QR: data too long');
      var countBits = ver <= 9 ? 8 : 16;
      if (4 + countBits + bytes.length * 8 <= dataCodewords(ver) * 8) break;
    }
    var bits = [];
    function put(val, len) {
      for (var i = len - 1; i >= 0; i--) bits.push((val >>> i) & 1);
    }
    put(4, 4);
    put(bytes.length, ver <= 9 ? 8 : 16);
    bytes.forEach(function (b) {
      put(b, 8);
    });
    var capacity = dataCodewords(ver) * 8;
    put(0, Math.min(4, capacity - bits.length));
    put(0, (8 - (bits.length % 8)) % 8);
    for (var pad = 0xec; bits.length < capacity; pad ^= 0xec ^ 0x11) put(pad, 8);
    var data = [];
    for (var k = 0; k < bits.length; k += 8) {
      var v = 0;
      for (var j = 0; j < 8; j++) v = (v << 1) | bits[k + j];
      data.push(v);
    }

    // Reed–Solomon over GF(2^8) with the polynomial 0x11D.
    function mul(x, y) {
      var z = 0;
      for (var i = 7; i >= 0; i--) {
        z = (z << 1) ^ ((z >>> 7) * 0x11d);
        z ^= ((y >>> i) & 1) * x;
      }
      return z & 0xff;
    }
    function divisor(degree) {
      var r = [];
      for (var i = 0; i < degree - 1; i++) r.push(0);
      r.push(1);
      var root = 1;
      for (var i2 = 0; i2 < degree; i2++) {
        for (var j2 = 0; j2 < r.length; j2++) {
          r[j2] = mul(r[j2], root);
          if (j2 + 1 < r.length) r[j2] ^= r[j2 + 1];
        }
        root = mul(root, 0x02);
      }
      return r;
    }
    function remainder(msg, div) {
      var r = div.map(function () {
        return 0;
      });
      msg.forEach(function (b) {
        var factor = b ^ r.shift();
        r.push(0);
        div.forEach(function (coef, i) {
          r[i] ^= mul(coef, factor);
        });
      });
      return r;
    }

    // Split into blocks, add the error correction, interleave.
    var numBlocks = BLOCKS[ecl[0]][ver];
    var eccLen = ECC_PER_BLOCK[ecl[0]][ver];
    var rawCodewords = Math.floor(rawModules(ver) / 8);
    var numShort = numBlocks - (rawCodewords % numBlocks);
    var shortLen = Math.floor(rawCodewords / numBlocks);
    var div = divisor(eccLen);
    var blocks = [];
    for (var b = 0, at = 0; b < numBlocks; b++) {
      var dat = data.slice(at, at + shortLen - eccLen + (b < numShort ? 0 : 1));
      at += dat.length;
      var ecc = remainder(dat, div);
      if (b < numShort) dat.push(0);
      blocks.push(dat.concat(ecc));
    }
    var codewords = [];
    for (var i3 = 0; i3 < blocks[0].length; i3++) {
      for (var j3 = 0; j3 < blocks.length; j3++) {
        if (i3 !== shortLen - eccLen || j3 >= numShort) codewords.push(blocks[j3][i3]);
      }
    }

    // The grid and its function patterns.
    var size = ver * 4 + 17;
    var modules = [];
    var isFn = [];
    for (var y0 = 0; y0 < size; y0++) {
      modules.push(new Array(size).fill(false));
      isFn.push(new Array(size).fill(false));
    }
    function setFn(x, y, dark) {
      modules[y][x] = dark;
      isFn[y][x] = true;
    }
    for (var t = 0; t < size; t++) {
      setFn(6, t, t % 2 === 0);
      setFn(t, 6, t % 2 === 0);
    }
    function finder(x, y) {
      for (var dy = -4; dy <= 4; dy++) {
        for (var dx = -4; dx <= 4; dx++) {
          var dist = Math.max(Math.abs(dx), Math.abs(dy));
          var xx = x + dx;
          var yy = y + dy;
          if (xx >= 0 && xx < size && yy >= 0 && yy < size) setFn(xx, yy, dist !== 2 && dist !== 4);
        }
      }
    }
    finder(3, 3);
    finder(size - 4, 3);
    finder(3, size - 4);
    var align = [];
    if (ver > 1) {
      var na = Math.floor(ver / 7) + 2;
      var step = Math.floor((ver * 8 + na * 3 + 5) / (na * 4 - 4)) * 2;
      align = [6];
      for (var pos = size - 7; align.length < na; pos -= step) align.splice(1, 0, pos);
    }
    for (var ai = 0; ai < align.length; ai++) {
      for (var aj = 0; aj < align.length; aj++) {
        if ((ai === 0 && aj === 0) || (ai === 0 && aj === align.length - 1) || (ai === align.length - 1 && aj === 0))
          continue;
        for (var ay = -2; ay <= 2; ay++) {
          for (var ax = -2; ax <= 2; ax++)
            setFn(align[ai] + ax, align[aj] + ay, Math.max(Math.abs(ax), Math.abs(ay)) !== 1);
        }
      }
    }
    function bit(x, i) {
      return ((x >>> i) & 1) !== 0;
    }
    function formatBits(mask) {
      var d = (ecl[1] << 3) | mask;
      var rem = d;
      for (var i = 0; i < 10; i++) rem = (rem << 1) ^ ((rem >>> 9) * 0x537);
      var f = ((d << 10) | rem) ^ 0x5412;
      for (var i2 = 0; i2 <= 5; i2++) setFn(8, i2, bit(f, i2));
      setFn(8, 7, bit(f, 6));
      setFn(8, 8, bit(f, 7));
      setFn(7, 8, bit(f, 8));
      for (var i3 = 9; i3 < 15; i3++) setFn(14 - i3, 8, bit(f, i3));
      for (var i4 = 0; i4 < 8; i4++) setFn(size - 1 - i4, 8, bit(f, i4));
      for (var i5 = 8; i5 < 15; i5++) setFn(8, size - 15 + i5, bit(f, i5));
      setFn(8, size - 8, true);
    }
    formatBits(0); // reserves the area; redrawn with the chosen mask
    if (ver >= 7) {
      var rem = ver;
      for (var vi = 0; vi < 12; vi++) rem = (rem << 1) ^ ((rem >>> 11) * 0x1f25);
      var vbits = (ver << 12) | rem;
      for (var vj = 0; vj < 18; vj++) {
        var vb = bit(vbits, vj);
        var a = size - 11 + (vj % 3);
        var bb = Math.floor(vj / 3);
        setFn(a, bb, vb);
        setFn(bb, a, vb);
      }
    }

    // The data, in the zig-zag order.
    var n = 0;
    for (var right = size - 1; right >= 1; right -= 2) {
      if (right === 6) right = 5;
      for (var vert = 0; vert < size; vert++) {
        for (var jj = 0; jj < 2; jj++) {
          var x = right - jj;
          var upward = ((right + 1) & 2) === 0;
          var y = upward ? size - 1 - vert : vert;
          if (!isFn[y][x] && n < codewords.length * 8) {
            modules[y][x] = bit(codewords[n >>> 3], 7 - (n & 7));
            n++;
          }
        }
      }
    }

    function applyMask(mask) {
      for (var y = 0; y < size; y++) {
        for (var x = 0; x < size; x++) {
          if (isFn[y][x]) continue;
          var inv;
          switch (mask) {
            case 0:
              inv = (x + y) % 2 === 0;
              break;
            case 1:
              inv = y % 2 === 0;
              break;
            case 2:
              inv = x % 3 === 0;
              break;
            case 3:
              inv = (x + y) % 3 === 0;
              break;
            case 4:
              inv = (Math.floor(x / 3) + Math.floor(y / 2)) % 2 === 0;
              break;
            case 5:
              inv = ((x * y) % 2) + ((x * y) % 3) === 0;
              break;
            case 6:
              inv = (((x * y) % 2) + ((x * y) % 3)) % 2 === 0;
              break;
            default:
              inv = (((x + y) % 2) + ((x * y) % 3)) % 2 === 0;
          }
          if (inv) modules[y][x] = !modules[y][x];
        }
      }
    }

    // The mask with the lowest penalty (the spec's four rules).
    function addHistory(len, h) {
      if (h[0] === 0) len += size;
      h.pop();
      h.unshift(len);
    }
    function countPatterns(h) {
      var m = h[1];
      var core = m > 0 && h[2] === m && h[3] === m * 3 && h[4] === m && h[5] === m;
      return (core && h[0] >= m * 4 && h[6] >= m ? 1 : 0) + (core && h[6] >= m * 4 && h[0] >= m ? 1 : 0);
    }
    function terminate(color, len, h) {
      if (color) {
        addHistory(len, h);
        len = 0;
      }
      len += size;
      addHistory(len, h);
      return countPatterns(h);
    }
    function penalty() {
      var score = 0;
      for (var pass = 0; pass < 2; pass++) {
        for (var a = 0; a < size; a++) {
          var color = false;
          var run = 0;
          var h = [0, 0, 0, 0, 0, 0, 0];
          for (var b = 0; b < size; b++) {
            var cell = pass === 0 ? modules[a][b] : modules[b][a];
            if (cell === color) {
              run++;
              if (run === 5) score += 3;
              else if (run > 5) score++;
            } else {
              addHistory(run, h);
              if (!color) score += countPatterns(h) * 40;
              color = cell;
              run = 1;
            }
          }
          score += terminate(color, run, h) * 40;
        }
      }
      for (var y = 0; y < size - 1; y++) {
        for (var x = 0; x < size - 1; x++) {
          var c0 = modules[y][x];
          if (c0 === modules[y][x + 1] && c0 === modules[y + 1][x] && c0 === modules[y + 1][x + 1]) score += 3;
        }
      }
      var dark = 0;
      modules.forEach(function (row) {
        row.forEach(function (cell) {
          if (cell) dark++;
        });
      });
      var total = size * size;
      score += (Math.ceil(Math.abs(dark * 20 - total * 10) / total) - 1) * 10;
      return score;
    }

    var best = forcedMask;
    if (best === undefined || best === null) {
      var bestScore = Infinity;
      for (var m = 0; m < 8; m++) {
        applyMask(m);
        formatBits(m);
        var p = penalty();
        if (p < bestScore) {
          best = m;
          bestScore = p;
        }
        applyMask(m);
      }
    }
    applyMask(best);
    formatBits(best);
    return { size: size, version: ver, mask: best, modules: modules };
  }

  /** The QR as an SVG string: dark modules on white, with the spec's 4-module quiet zone. */
  function qrSvg(text, size) {
    // Level L: the long link stays a smaller code (bigger modules), easier to read off a screen.
    var m = qrMatrix(text, 'L');
    var view = m.size + 8;
    var path = '';
    for (var y = 0; y < m.size; y++) {
      for (var x = 0; x < m.size; x++) if (m.modules[y][x]) path += 'M' + (x + 4) + ' ' + (y + 4) + 'h1v1h-1z';
    }
    return (
      '<svg xmlns="http://www.w3.org/2000/svg" width="' +
      size +
      '" height="' +
      size +
      '" viewBox="0 0 ' +
      view +
      ' ' +
      view +
      '" shape-rendering="crispEdges" role="img" aria-label="QR code: chat on WhatsApp on your phone">' +
      '<rect width="' +
      view +
      '" height="' +
      view +
      '" fill="#fff"/><path d="' +
      path +
      '" fill="#111"/><\/svg>'
    );
  }

  // ---------- WhatsApp entry points ----------
  //
  // Both are plain links to Qwikspot's GET /api/wa redirect, which records the click and answers
  // with the wa.me link. A tap navigates at once — no waiting for an API answer first — so a phone
  // keeps the tap's permission to open the WhatsApp app, and a computer's popup blocker allows it.

  function hideEntryPoints() {
    entryPoints.forEach(function (el) {
      el.style.display = 'none';
    });
  }

  /** The /api/wa link for an entry point, with the chosen variant and this browser's two random ids. */
  function waHref(entry) {
    var ids = {};
    try {
      ids = api().ids() || {};
    } catch (e) {
      /* storage blocked: the redirect still opens the brand's chat */
    }
    var params = new URLSearchParams();
    params.set('brand', config.brandId);
    params.set('entry', entry);
    var variant = config.template === 'product' ? numeric(selectedVariant()) : null;
    if (variant) params.set('variant', variant);
    if (ids.web_session_id) params.set('session', ids.web_session_id);
    if (ids.visitor_id) params.set('visitor', ids.visitor_id);
    return config.apiBaseUrl.replace(/\/$/, '') + '/api/wa?' + params.toString();
  }

  var qrBox = null;

  /** The desktop QR: the same link as the button, marked as scanned (no Referer from a camera). */
  function drawQr() {
    if (!qrBox) return;
    try {
      qrBox.querySelector('.qs-qr__code').innerHTML = qrSvg(waHref('STORE_NEED') + '&via=qr', 176);
    } catch (e) {
      qrBox.style.display = 'none'; // never break the theme
    }
  }

  function updateLinks() {
    entryPoints.forEach(function (el) {
      if (el.getAttribute('data-qs-entry')) el.href = waHref(el.getAttribute('data-qs-entry'));
    });
    drawQr();
  }

  function reportToGa4(entry) {
    try {
      if (typeof window.gtag !== 'function') return;
      var data = { entry: entry };
      var id = config.template === 'product' ? numeric(selectedVariant()) : null;
      if (id) data.item_id = id;
      if (product && product.title) data.item_name = product.title;
      window.gtag('event', 'qwikspot_whatsapp_click', data);
    } catch (e) {
      /* reporting only */
    }
  }

  /** An entry point: a real link (same tab on a phone, so the app opens; a new tab on a computer). */
  function waLink(entry, className, label) {
    var a = document.createElement('a');
    a.className = className;
    a.setAttribute('data-qs-entry', entry);
    a.href = waHref(entry);
    // The redirect checks the store's origin: always send it, whatever the theme's referrer policy.
    a.referrerPolicy = 'strict-origin-when-cross-origin';
    if (!isMobile()) {
      a.target = '_blank';
      a.rel = 'noopener';
    }
    a.addEventListener('click', function () {
      a.href = waHref(entry); // the latest size and ids
      reportToGa4(entry);
      if (label) {
        a.textContent = 'Opening WhatsApp…';
        setTimeout(function () {
          a.textContent = label;
        }, 3000);
      } else {
        a.classList.add('qs-opening');
        setTimeout(function () {
          a.classList.remove('qs-opening');
        }, 3000);
      }
    });
    entryPoints.push(a);
    return a;
  }

  var STYLE =
    '.qs-need{display:block;box-sizing:border-box;width:100%;margin:12px 0 4px;padding:14px 16px;border:1px solid #1f7a4d;' +
    'border-radius:8px;background:#fff;color:#1f7a4d;font:inherit;font-weight:600;text-align:center;text-decoration:none;' +
    'cursor:pointer;-webkit-tap-highlight-color:transparent;transition:background .15s,transform .1s}' +
    '.qs-need:hover{background:#f1faf5}.qs-need:active{background:#dff3e8;transform:scale(.98)}' +
    '.qs-powered{margin:0 0 12px;font-size:12px;opacity:.6;text-align:center}' +
    '.qs-bubble{position:fixed;right:16px;bottom:calc(16px + env(safe-area-inset-bottom,0px));z-index:2147483000;' +
    'width:56px;height:56px;border-radius:50%;background:#25d366;box-shadow:0 4px 14px rgba(0,0,0,.25);cursor:pointer;' +
    'display:flex;align-items:center;justify-content:center;-webkit-tap-highlight-color:transparent;' +
    'transition:transform .1s,box-shadow .15s,bottom .2s}' +
    '.qs-bubble:active,.qs-bubble.qs-opening{transform:scale(.92);box-shadow:0 2px 8px rgba(0,0,0,.3)}' +
    '.qs-bubble svg{width:30px;height:30px;fill:#fff}' +
    '@media (max-width:749px){.qs-bubble{right:12px;bottom:calc(12px + env(safe-area-inset-bottom,0px))}}' +
    '.qs-qr{display:flex;align-items:center;gap:14px;box-sizing:border-box;width:100%;margin:8px 0 4px;padding:12px;' +
    'border:1px solid #d9e7df;border-radius:8px;background:#fff;color:inherit;font:inherit;font-size:14px}' +
    '.qs-qr__code{flex:none;line-height:0}.qs-qr__code svg{display:block;border-radius:4px}' +
    '.qs-qr__text{display:grid;gap:2px}.qs-qr__text strong{color:#1f7a4d}.qs-qr__text span{opacity:.75;font-size:13px}';

  var WHATSAPP_ICON =
    '<svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3C9 3 3.3 8.6 3.3 15.6c0 2.2.6 4.4 1.7 6.3L3 29l7.3-1.9' +
    'c1.8 1 3.8 1.5 5.8 1.5 7 0 12.7-5.7 12.7-12.6S23 3 16 3zm0 23.1c-1.8 0-3.6-.5-5.1-1.4l-.4-.2-4.3 1.1 1.2-4.2-.3-.4' +
    'c-1-1.6-1.5-3.4-1.5-5.3 0-5.8 4.7-10.5 10.5-10.5s10.5 4.7 10.5 10.5S21.8 26.1 16 26.1zm5.8-7.9c-.3-.2-1.9-.9-2.2-1' +
    '-.3-.1-.5-.2-.7.2-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-.3-.2-1.3-.5-2.6-1.6-1-.9-1.6-1.9-1.8-2.2-.2-.3 0-.5.1-.6l.5-.6' +
    'c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.4 3.4' +
    'c.2.2 2.4 3.6 5.7 5 .8.3 1.4.5 1.9.7.8.3 1.5.2 2.1.1.6-.1 1.9-.8 2.2-1.5.3-.7.3-1.4.2-1.5-.1-.1-.3-.2-.6-.4z"/><\/svg>';

  function addStyle() {
    var style = document.createElement('style');
    style.textContent = STYLE;
    document.head.appendChild(style);
  }

  function addProductButton() {
    var submit = document.querySelector(
      'form[action*="/cart/add"] [type="submit"], form[action*="/cart/add"] button[name="add"]',
    );
    var anchor = submit || document.querySelector('.price, [class*="price"]');
    if (!anchor || !anchor.parentNode) return;
    var label = 'Need it today? Ask on WhatsApp';
    var button = waLink('STORE_NEED', 'qs-need', label);
    button.textContent = label;
    var powered = document.createElement('p');
    powered.className = 'qs-powered';
    powered.textContent = 'Powered by Qwikspot';
    // After the submit button's own row (its parent), so the theme's button layout is untouched.
    var after = submit && submit.parentNode && submit.parentNode !== submit.form ? submit.parentNode : anchor;
    after.parentNode.insertBefore(powered, after.nextSibling);
    after.parentNode.insertBefore(button, powered);
    entryPoints.push(powered);
    // On a computer: a QR the shopper scans to continue on their phone's WhatsApp.
    if (!isMobile()) {
      // Built with DOM calls: a closing tag inside the script would break Shopify's theme editor.
      qrBox = document.createElement('div');
      qrBox.className = 'qs-qr';
      var code = document.createElement('div');
      code.className = 'qs-qr__code';
      var text = document.createElement('div');
      text.className = 'qs-qr__text';
      var title = document.createElement('strong');
      title.textContent = 'On your phone?';
      var hint = document.createElement('span');
      hint.textContent = 'Scan to chat on WhatsApp — the message about this product is ready to send.';
      text.appendChild(title);
      text.appendChild(hint);
      qrBox.appendChild(code);
      qrBox.appendChild(text);
      after.parentNode.insertBefore(qrBox, powered.nextSibling);
      entryPoints.push(qrBox);
      drawQr();
    }
  }

  var bubble = null;

  /**
   * Keeps the bubble above a bar the theme fixes to the bottom of the screen (Savor's sticky
   * Add to cart, a cookie banner): it never covers the theme's own buttons.
   */
  function placeBubble() {
    if (!bubble) return;
    var lift = 0;
    var candidates = document.querySelectorAll(
      '[class*="sticky"], [id*="sticky"], [class*="Sticky"], sticky-add-to-cart',
    );
    for (var i = 0; i < candidates.length; i++) {
      var el = candidates[i];
      if (el === bubble || el.contains(bubble)) continue;
      var style = window.getComputedStyle(el);
      if (
        (style.position !== 'fixed' && style.position !== 'sticky') ||
        style.display === 'none' ||
        style.visibility === 'hidden'
      )
        continue;
      var rect = el.getBoundingClientRect();
      if (rect.height > 0 && rect.height < 240 && rect.bottom >= window.innerHeight - 2) {
        lift = Math.max(lift, window.innerHeight - rect.top);
      }
    }
    bubble.style.bottom = lift > 0 ? 'calc(' + (lift + 12) + 'px + env(safe-area-inset-bottom, 0px))' : '';
  }

  function addBubble() {
    bubble = waLink('CHAT', 'qs-bubble', null);
    bubble.setAttribute('aria-label', 'Chat on WhatsApp');
    bubble.innerHTML = WHATSAPP_ICON;
    document.body.appendChild(bubble);
    var scheduled = false;
    var schedule = function () {
      if (scheduled) return;
      scheduled = true;
      setTimeout(function () {
        scheduled = false;
        placeBubble();
      }, 200);
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    placeBubble();
  }

  // ---------- start ----------

  function trackPage() {
    try {
      if (!window.sessionStorage.getItem(VISIT_KEY)) {
        window.sessionStorage.setItem(VISIT_KEY, '1');
        send('STOREFRONT_VISIT');
      }
    } catch (e) {
      send('STOREFRONT_VISIT');
    }
    var template = String(config.template || '');
    if (template.indexOf('search') === 0 && config.searchTerms)
      send('SEARCH', { searchTerm: String(config.searchTerms) });
    if (template === 'product' && gid(selectedVariant())) {
      currentVariant = selectedVariant();
      send('PRODUCT_DETAIL_VIEW', { variantId: gid(currentVariant) });
    }
  }

  function start() {
    try {
      intent = window.QwikspotIntent;
      intent.init({ apiBaseUrl: config.apiBaseUrl, brandId: config.brandId, openLink: noop });
      addStyle();
      if (config.template === 'product') addProductButton();
      addBubble();
      watchVariants();
      watchCart();
      trackPage();
    } catch (e) {
      /* never break the theme */
    }
  }

  function whenReady(fn) {
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fn);
    else fn();
  }

  if (api()) {
    whenReady(start);
  } else {
    var script = document.createElement('script');
    script.src = config.apiBaseUrl.replace(/\/$/, '') + '/qwikspot-intent.js';
    script.async = true;
    script.onload = function () {
      if (api()) whenReady(start);
    };
    document.head.appendChild(script);
  }

  // For tests: the pure helpers.
  window.__qwikspotShopifyHelpers = {
    gid: gid,
    numeric: numeric,
    variantFromBody: variantFromBody,
    qrMatrix: qrMatrix,
  };
})();
</script>
