{%- comment -%}
  Qwikspot for Shopify (L4). Paste this whole file into Online Store → Themes → Edit code →
  Snippets → "qwikspot", then add {% render 'qwikspot' %} just before </body> in layout/theme.liquid.
  Generated from integrations/shopify/qwikspot-shopify.js by `npm run shopify:snippet` — edit
  that file and rebuild rather than changing the script below by hand.

  The two settings: where Qwikspot runs, and this store's brand id in Qwikspot.
{%- endcomment -%}
{%- liquid
  assign qs_api = 'https://app.qwikspot.urbanlyfe.in'
  assign qs_brand = 'brd_demo'
-%}
<script id="qwikspot-config" type="application/json">
  {
    "apiBaseUrl": {{ qs_api | json }},
    "brandId": {{ qs_brand | json }},
    "template": {{ template.name | json }},
    "product": {%- if template.name == 'product' and product -%}
      {
        "title": {{ product.title | json }},
        "variant": {{ product.selected_or_first_available_variant.id | json }}
      }
    {%- else -%}null{%- endif -%},
    "searchTerms": {%- if search.performed -%}{{ search.terms | json }}{%- else -%}null{%- endif -%},
    "cartVariant": {%- if cart.item_count > 0 -%}{{ cart.items.first.variant_id | json }}{%- else -%}null{%- endif %}
  }
</script>
<script>
/*
 * Qwikspot for Shopify themes (L4): tracks the shopper's steps for intent, and adds
 * "Need it today? Ask on WhatsApp" under Add to cart plus a WhatsApp bubble on every page.
 *
 * Source of the script tag inside integrations/shopify/qwikspot.liquid — edit this file, then run
 * `npm run shopify:snippet` (scripts/build-shopify-snippet.mjs) to rebuild the Liquid snippet.
 *
 * Reads its settings from the JSON script tag with id "qwikspot-config" (written by the
 * Liquid snippet from Shopify's own objects). Sends only variant GIDs, the search words and
 * event types — never names, emails, phone numbers or cart tokens. Every failure is silent.
 */
(function () {
  'use strict';
  if (window.__qwikspotShopify) return; // the theme rendered the snippet twice
  window.__qwikspotShopify = true;

  var VISIT_KEY = 'qs_visit_sent';
  var GID = 'gid://shopify/ProductVariant/';
  var config = readConfig();
  if (!config || !config.apiBaseUrl || !config.brandId) return;

  var product = config.product || null;
  var currentVariant = product && product.variant ? String(product.variant) : null;
  var lastSent = {};
  var entryPoints = [];
  var warned = false;

  function readConfig() {
    try {
      var el = document.getElementById('qwikspot-config');
      return el ? JSON.parse(el.textContent || '{}') : null;
    } catch (e) {
      return null;
    }
  }

  function noop() {}

  /** "12345" or "gid://shopify/ProductVariant/12345" → the GID the backend stores; null otherwise. */
  function gid(id) {
    var digits = id === null || id === undefined ? '' : String(id).replace(/^gid:\/\/shopify\/ProductVariant\//, '');
    return /^\d+$/.test(digits) ? GID + digits : null;
  }

  function numeric(id) {
    var g = gid(id);
    return g ? g.slice(GID.length) : null;
  }

  var intent = null;
  /** QwikspotIntent as it was when this snippet started (later replacements are ignored). */
  function api() {
    return intent || window.QwikspotIntent;
  }

  /** Sends one event; the same event for the same variant at most once per 1.5 s (submit + fetch). */
  function send(type, data) {
    try {
      var key = type + ':' + ((data && (data.variantId || data.searchTerm)) || '');
      var now = Date.now();
      if (lastSent[key] && now - lastSent[key] < 1500) return;
      lastSent[key] = now;
      var result = api().track(type, data || {});
      if (result && result.then) {
        result.then(function (res) {
          // Hidden only when Qwikspot says so — never because a request failed.
          if (res && res.whatsapp_available === false) hideEntryPoints();
        }, warnOnce);
      }
    } catch (e) {
      warnOnce(e);
    }
  }

  /** Shoppers see nothing; one line in DevTools per page says why events are not arriving. */
  function warnOnce(err) {
    if (warned) return;
    warned = true;
    try {
      var why =
        err && typeof err.status === 'number'
          ? 'HTTP ' + err.status + (err.error && err.error.code ? ' ' + err.error.code : '')
          : 'blocked (CORS/network)';
      console.warn('[Qwikspot] storefront events are not reaching Qwikspot: ' + why);
    } catch (e) {
      /* ignore */
    }
  }

  function isMobile() {
    return /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent || '');
  }

  // ---------- variants ----------

  /** The variant the shopper has chosen: the product form's id input, else ?variant=, else the first. */
  function selectedVariant() {
    var input = document.querySelector('form[action*="/cart/add"] [name="id"]');
    if (input && input.value && gid(input.value)) return String(input.value);
    var fromUrl = new URLSearchParams(window.location.search).get('variant');
    if (fromUrl && gid(fromUrl)) return fromUrl;
    return currentVariant;
  }

  function checkVariant() {
    var next = selectedVariant();
    if (next && next !== currentVariant) {
      currentVariant = next;
      send('VARIANT_SELECTED', { variantId: gid(next) });
      updateLinks();
    }
  }

  function watchVariants() {
    // Savor / Dawn-style themes change the hidden id input and replace ?variant= in the URL.
    document.addEventListener('change', function () {
      setTimeout(checkVariant, 0);
    });
    ['pushState', 'replaceState'].forEach(function (name) {
      var original = window.history[name];
      if (typeof original !== 'function') return;
      window.history[name] = function () {
        var result = original.apply(this, arguments);
        setTimeout(checkVariant, 0);
        return result;
      };
    });
    window.addEventListener('popstate', checkVariant);
  }

  // ---------- cart and checkout ----------

  function variantFromBody(body) {
    try {
      if (!body) return null;
      if (typeof FormData !== 'undefined' && body instanceof FormData) return body.get('id');
      if (typeof URLSearchParams !== 'undefined' && body instanceof URLSearchParams) return body.get('id');
      if (typeof body === 'string') {
        if (body.charAt(0) === '{') {
          var json = JSON.parse(body);
          return json.id || (json.items && json.items[0] && json.items[0].id) || null;
        }
        return new URLSearchParams(body).get('id');
      }
    } catch (e) {
      /* unknown body */
    }
    return null;
  }

  function watchCart() {
    // A plain product form submit (themes without AJAX cart).
    document.addEventListener(
      'submit',
      function (event) {
        var form = event.target;
        if (!form || !form.getAttribute || (form.getAttribute('action') || '').indexOf('/cart/add') === -1) return;
        var input = form.querySelector('[name="id"]');
        var id = gid(input && input.value);
        if (id) send('ADD_TO_CART', { variantId: id });
      },
      true,
    );
    // AJAX carts call /cart/add with fetch: wrapped, never changed.
    if (typeof window.fetch === 'function') {
      var originalFetch = window.fetch;
      window.fetch = function (resource, init) {
        try {
          var url = typeof resource === 'string' ? resource : (resource && resource.url) || '';
          if (url.indexOf('/cart/add') !== -1) {
            var id = gid(variantFromBody(init && init.body));
            if (id) send('ADD_TO_CART', { variantId: id });
          }
        } catch (e) {
          /* ignore */
        }
        return originalFetch.apply(this, arguments);
      };
    }
    // The cart page's or the cart drawer's checkout button.
    document.addEventListener(
      'click',
      function (event) {
        var target =
          event.target && event.target.closest ? event.target.closest('[name="checkout"], a[href*="/checkout"]') : null;
        if (!target) return;
        var fromLiquid = gid(config.cartVariant);
        if (fromLiquid) return send('CHECKOUT_STARTED', { variantId: fromLiquid });
        if (typeof window.fetch !== 'function') return;
        window
          .fetch('/cart.js', { credentials: 'same-origin' })
          .then(function (res) {
            return res.json();
          })
          .then(function (cart) {
            var id = gid(cart && cart.items && cart.items[0] && cart.items[0].variant_id);
            if (id) send('CHECKOUT_STARTED', { variantId: id });
          })
          .catch(noop);
      },
      true,
    );
  }

  // ---------- WhatsApp entry points ----------
  //
  // Both are plain links to Qwikspot's GET /api/wa redirect, which records the click and answers
  // with the wa.me link. A tap navigates at once — no waiting for an API answer first — so a phone
  // keeps the tap's permission to open the WhatsApp app, and a computer's popup blocker allows it.

  function hideEntryPoints() {
    entryPoints.forEach(function (el) {
      el.style.display = 'none';
    });
  }

  /** The /api/wa link for an entry point, with the chosen variant and this browser's two random ids. */
  function waHref(entry) {
    var ids = {};
    try {
      ids = api().ids() || {};
    } catch (e) {
      /* storage blocked: the redirect still opens the brand's chat */
    }
    var params = new URLSearchParams();
    params.set('brand', config.brandId);
    params.set('entry', entry);
    var variant = config.template === 'product' ? numeric(selectedVariant()) : null;
    if (variant) params.set('variant', variant);
    if (ids.web_session_id) params.set('session', ids.web_session_id);
    if (ids.visitor_id) params.set('visitor', ids.visitor_id);
    return config.apiBaseUrl.replace(/\/$/, '') + '/api/wa?' + params.toString();
  }

  function updateLinks() {
    entryPoints.forEach(function (el) {
      if (el.getAttribute('data-qs-entry')) el.href = waHref(el.getAttribute('data-qs-entry'));
    });
  }

  function reportToGa4(entry) {
    try {
      if (typeof window.gtag !== 'function') return;
      var data = { entry: entry };
      var id = config.template === 'product' ? numeric(selectedVariant()) : null;
      if (id) data.item_id = id;
      if (product && product.title) data.item_name = product.title;
      window.gtag('event', 'qwikspot_whatsapp_click', data);
    } catch (e) {
      /* reporting only */
    }
  }

  /** An entry point: a real link (same tab on a phone, so the app opens; a new tab on a computer). */
  function waLink(entry, className, label) {
    var a = document.createElement('a');
    a.className = className;
    a.setAttribute('data-qs-entry', entry);
    a.href = waHref(entry);
    // The redirect checks the store's origin: always send it, whatever the theme's referrer policy.
    a.referrerPolicy = 'strict-origin-when-cross-origin';
    if (!isMobile()) {
      a.target = '_blank';
      a.rel = 'noopener';
    }
    a.addEventListener('click', function () {
      a.href = waHref(entry); // the latest size and ids
      reportToGa4(entry);
      if (label) {
        a.textContent = 'Opening WhatsApp…';
        setTimeout(function () {
          a.textContent = label;
        }, 3000);
      } else {
        a.classList.add('qs-opening');
        setTimeout(function () {
          a.classList.remove('qs-opening');
        }, 3000);
      }
    });
    entryPoints.push(a);
    return a;
  }

  var STYLE =
    '.qs-need{display:block;box-sizing:border-box;width:100%;margin:12px 0 4px;padding:14px 16px;border:1px solid #1f7a4d;' +
    'border-radius:8px;background:#fff;color:#1f7a4d;font:inherit;font-weight:600;text-align:center;text-decoration:none;' +
    'cursor:pointer;-webkit-tap-highlight-color:transparent;transition:background .15s,transform .1s}' +
    '.qs-need:hover{background:#f1faf5}.qs-need:active{background:#dff3e8;transform:scale(.98)}' +
    '.qs-powered{margin:0 0 12px;font-size:12px;opacity:.6;text-align:center}' +
    '.qs-bubble{position:fixed;right:16px;bottom:calc(16px + env(safe-area-inset-bottom,0px));z-index:2147483000;' +
    'width:56px;height:56px;border-radius:50%;background:#25d366;box-shadow:0 4px 14px rgba(0,0,0,.25);cursor:pointer;' +
    'display:flex;align-items:center;justify-content:center;-webkit-tap-highlight-color:transparent;' +
    'transition:transform .1s,box-shadow .15s,bottom .2s}' +
    '.qs-bubble:active,.qs-bubble.qs-opening{transform:scale(.92);box-shadow:0 2px 8px rgba(0,0,0,.3)}' +
    '.qs-bubble svg{width:30px;height:30px;fill:#fff}' +
    '@media (max-width:749px){.qs-bubble{right:12px;bottom:calc(12px + env(safe-area-inset-bottom,0px))}}';

  var WHATSAPP_ICON =
    '<svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3C9 3 3.3 8.6 3.3 15.6c0 2.2.6 4.4 1.7 6.3L3 29l7.3-1.9' +
    'c1.8 1 3.8 1.5 5.8 1.5 7 0 12.7-5.7 12.7-12.6S23 3 16 3zm0 23.1c-1.8 0-3.6-.5-5.1-1.4l-.4-.2-4.3 1.1 1.2-4.2-.3-.4' +
    'c-1-1.6-1.5-3.4-1.5-5.3 0-5.8 4.7-10.5 10.5-10.5s10.5 4.7 10.5 10.5S21.8 26.1 16 26.1zm5.8-7.9c-.3-.2-1.9-.9-2.2-1' +
    '-.3-.1-.5-.2-.7.2-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-.3-.2-1.3-.5-2.6-1.6-1-.9-1.6-1.9-1.8-2.2-.2-.3 0-.5.1-.6l.5-.6' +
    'c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.4 3.4' +
    'c.2.2 2.4 3.6 5.7 5 .8.3 1.4.5 1.9.7.8.3 1.5.2 2.1.1.6-.1 1.9-.8 2.2-1.5.3-.7.3-1.4.2-1.5-.1-.1-.3-.2-.6-.4z"/><\/svg>';

  function addStyle() {
    var style = document.createElement('style');
    style.textContent = STYLE;
    document.head.appendChild(style);
  }

  function addProductButton() {
    var submit = document.querySelector(
      'form[action*="/cart/add"] [type="submit"], form[action*="/cart/add"] button[name="add"]',
    );
    var anchor = submit || document.querySelector('.price, [class*="price"]');
    if (!anchor || !anchor.parentNode) return;
    var label = 'Need it today? Ask on WhatsApp';
    var button = waLink('STORE_NEED', 'qs-need', label);
    button.textContent = label;
    var powered = document.createElement('p');
    powered.className = 'qs-powered';
    powered.textContent = 'Powered by Qwikspot';
    // After the submit button's own row (its parent), so the theme's button layout is untouched.
    var after = submit && submit.parentNode && submit.parentNode !== submit.form ? submit.parentNode : anchor;
    after.parentNode.insertBefore(powered, after.nextSibling);
    after.parentNode.insertBefore(button, powered);
    entryPoints.push(powered);
  }

  var bubble = null;

  /**
   * Keeps the bubble above a bar the theme fixes to the bottom of the screen (Savor's sticky
   * Add to cart, a cookie banner): it never covers the theme's own buttons.
   */
  function placeBubble() {
    if (!bubble) return;
    var lift = 0;
    var candidates = document.querySelectorAll(
      '[class*="sticky"], [id*="sticky"], [class*="Sticky"], sticky-add-to-cart',
    );
    for (var i = 0; i < candidates.length; i++) {
      var el = candidates[i];
      if (el === bubble || el.contains(bubble)) continue;
      var style = window.getComputedStyle(el);
      if (
        (style.position !== 'fixed' && style.position !== 'sticky') ||
        style.display === 'none' ||
        style.visibility === 'hidden'
      )
        continue;
      var rect = el.getBoundingClientRect();
      if (rect.height > 0 && rect.height < 240 && rect.bottom >= window.innerHeight - 2) {
        lift = Math.max(lift, window.innerHeight - rect.top);
      }
    }
    bubble.style.bottom = lift > 0 ? 'calc(' + (lift + 12) + 'px + env(safe-area-inset-bottom, 0px))' : '';
  }

  function addBubble() {
    bubble = waLink('CHAT', 'qs-bubble', null);
    bubble.setAttribute('aria-label', 'Chat on WhatsApp');
    bubble.innerHTML = WHATSAPP_ICON;
    document.body.appendChild(bubble);
    var scheduled = false;
    var schedule = function () {
      if (scheduled) return;
      scheduled = true;
      setTimeout(function () {
        scheduled = false;
        placeBubble();
      }, 200);
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    placeBubble();
  }

  // ---------- start ----------

  function trackPage() {
    try {
      if (!window.sessionStorage.getItem(VISIT_KEY)) {
        window.sessionStorage.setItem(VISIT_KEY, '1');
        send('STOREFRONT_VISIT');
      }
    } catch (e) {
      send('STOREFRONT_VISIT');
    }
    var template = String(config.template || '');
    if (template.indexOf('search') === 0 && config.searchTerms)
      send('SEARCH', { searchTerm: String(config.searchTerms) });
    if (template === 'product' && gid(selectedVariant())) {
      currentVariant = selectedVariant();
      send('PRODUCT_DETAIL_VIEW', { variantId: gid(currentVariant) });
    }
  }

  function start() {
    try {
      intent = window.QwikspotIntent;
      intent.init({ apiBaseUrl: config.apiBaseUrl, brandId: config.brandId, openLink: noop });
      addStyle();
      if (config.template === 'product') addProductButton();
      addBubble();
      watchVariants();
      watchCart();
      trackPage();
    } catch (e) {
      /* never break the theme */
    }
  }

  function whenReady(fn) {
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fn);
    else fn();
  }

  if (api()) {
    whenReady(start);
  } else {
    var script = document.createElement('script');
    script.src = config.apiBaseUrl.replace(/\/$/, '') + '/qwikspot-intent.js';
    script.async = true;
    script.onload = function () {
      if (api()) whenReady(start);
    };
    document.head.appendChild(script);
  }

  // For tests: the pure helpers.
  window.__qwikspotShopifyHelpers = { gid: gid, numeric: numeric, variantFromBody: variantFromBody };
})();
</script>
