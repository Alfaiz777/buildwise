# Frontend (Vite) configuration. Optional for local development.
#
# EVERYTHING HERE IS PUBLIC: VITE_* values are compiled into the browser bundle.
# Never put secrets here. The Firebase web config below is a public client
# identifier, not a credential.
#
# local profile (default): needs NO file at all — it uses the Firebase Auth
# emulator and the demo-qwikspot project automatically.
#
# gcp profile: copy to frontend/.env.production.local and fill in the web app
# config from Firebase console → Project settings → Your apps.
VITE_QWIKSPOT_PROFILE=gcp
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Empty = same origin (/api via the Vite dev proxy locally, Firebase Hosting rewrite when deployed).
VITE_API_BASE_URL=
