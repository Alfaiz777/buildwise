# Frontend (Vite) configuration. Copy to frontend/.env.local for local development.
#
# EVERYTHING HERE IS PUBLIC: VITE_* values are compiled into the browser bundle.
# Never put secrets here. The Firebase web config below is a public client
# identifier, not a credential.

# Local development against the Firebase Auth emulator (npm run emulators):
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-buildwise.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-buildwise
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# For a real project: use the web app config from
# Firebase console → Project settings → Your apps, and remove the emulator URL.

# Empty = same origin (/api via the Vite dev proxy locally, Firebase Hosting rewrite when deployed).
VITE_API_BASE_URL=
