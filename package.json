{
  "name": "qwikspot",
  "private": true,
  "description": "Qwikspot — AI-powered omnichannel commerce intelligence for D2C brands",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "emulators": "firebase emulators:start --project demo-qwikspot --only auth,firestore",
    "seed:platform-admin": "npm run seed:platform-admin --workspace backend --",
    "seed:demo": "npm run seed:demo --workspace backend",
    "demo:check": "npm run demo:check --workspace backend",
    "seed:live": "npm run seed:live --workspace backend --",
    "secrets:scan": "node scripts/secrets-scan.mjs",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces",
    "test:emulator": "firebase emulators:exec --project demo-qwikspot --only auth,firestore \"npm run test:emulator --workspace backend\""
  },
  "devDependencies": {
    "firebase-tools": "^15.31.0",
    "playwright": "^1.63.0",
    "prettier": "3.9.9"
  }
}
