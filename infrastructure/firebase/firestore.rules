rules_version = '2';

// Qwikspot: the browser never reads or writes Firestore directly.
// All data access goes through Cloud Run (Firebase Admin SDK bypasses these rules).
// See docs/03_TECH_ARCHITECTURE.md §7 and docs/07_SECURITY_SPEC.md §4.1.
// That includes the server-only Shopify collections (L2-Shopify): brands/{brandId}/integrationSecrets
// (encrypted store tokens), shopifyShops and oauthStates — no client rule may ever open them.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
